# ─────────────────────────────────────────────
# AI / Google
# ─────────────────────────────────────────────
# Required for Gemini AI API calls.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ─────────────────────────────────────────────
# App URL
# ─────────────────────────────────────────────
# The public URL where this app is hosted.
# Used for OAuth callbacks and self-referential links.
# Cloud Run example: https://your-service.asia-southeast1.run.app
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Development (SQLite - local file):
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./prisma/dev.db"

# Production (PostgreSQL - e.g. Neon, Supabase, Railway):
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="******host:5432/dbname?sslmode=require"

# ─────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────
# Change this to a long random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# ─────────────────────────────────────────────
# Meta / Facebook Graph API
# ─────────────────────────────────────────────
# Create an app at: https://developers.facebook.com/
FACEBOOK_APP_ID="YOUR_FACEBOOK_APP_ID"
FACEBOOK_APP_SECRET="YOUR_FACEBOOK_APP_SECRET"
FACEBOOK_VERIFY_TOKEN="your_custom_verify_token"
